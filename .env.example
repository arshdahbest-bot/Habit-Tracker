# Required for the Ask AI tab. Get a key at https://platform.claude.com (API keys).
# This stays on the server (the Expo dev server or your hosted API) and is never put in the app.
ANTHROPIC_API_KEY=

# Only for a published app: the web address where you deployed the API route (see README).
EXPO_PUBLIC_API_BASE_URL=

# Optional: shared online leaderboard (Supabase). Leave blank to use offline demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your own server endpoint that turns a photo into a cartoon avatar.
# It should accept POST { imageBase64 } and return { avatarUrl }.
EXPO_PUBLIC_AVATAR_API_URL=
